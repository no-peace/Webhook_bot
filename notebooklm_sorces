#!/usr/bin/env python3
"""Combine selected local repo files into multiple Markdown sources for NotebookLM."""

from pathlib import Path

# Repo root = directory where this script lives
ROOT = Path(__file__).resolve().parent
OUT_DIR = ROOT / "notebooklm_sources"
OUT_DIR.mkdir(exist_ok=True)

# Groups  separate .md files (avoids one huge source)
GROUPS = {
    "01_root_config.md": [
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
    ],
    "02_bot_config.md": [
        "bot/package.json",
        "bot/tsconfig.json",
        "bot/tsconfig.build.json",
    ],
    "03_client_config.md": [
        "client/package.json",
        "client/tsconfig.json",
        "client/Dockerfile",
        "client/src/styles/globals.css",
    ],
    "04_server_config.md": [
        "server/package.json",
        "server/tsconfig.json",
        "server/tsconfig.build.json",
        "server/Dockerfile",
        "server/src/middleware/verifyDiscordSignature_bfdb.ts",
    ],
    "05_shared_config.md": [
        "shared/package.json",
        "shared/tsconfig.json",
        "shared/tsconfig.build.json",
    ],
}

# Map extension  markdown fence language
LANG = {
    ".json": "json",
    ".css": "css",
    ".ts": "typescript",
    ".tsx": "tsx",
    ".js": "javascript",
    ".yml": "yaml",
    ".yaml": "yaml",
    ".md": "markdown",
    ".dockerfile": "dockerfile",
}


def fence_lang(path: Path) -> str:
    name = path.name.lower()
    if name == "dockerfile" or name.endswith(".dockerfile"):
        return "dockerfile"
    return LANG.get(path.suffix.lower(), path.suffix.lstrip(".") or "text")


def format_block(rel: str, content: str) -> str:
    p = Path(rel)
    filename = p.name  # e.g. package.json
    lang = fence_lang(p)
    # Your format:
    # filename.filetype
    # {filepath}
    # ```file.type
    # {file.src}
    # ```
    return (
        f"{filename}\n"
        f"{rel}\n"
        f"```{lang}\n"
        f"{content.rstrip()}\n"
        f"```\n"
    )


def main() -> None:
    written = []
    for out_name, rel_paths in GROUPS.items():
        parts = []
        for rel in rel_paths:
            full = ROOT / rel
            if not full.is_file():
                print(f"SKIP (missing): {rel}")
                continue
            text = full.read_text(encoding="utf-8", errors="replace")
            parts.append(format_block(rel, text))
            print(f"  + {rel}")

        if not parts:
            print(f"SKIP empty group: {out_name}")
            continue

        out_path = OUT_DIR / out_name
        header = f"# {out_name.replace('_', ' ').replace('.md', '')}\n\n"
        out_path.write_text(header + "\n\n".join(parts), encoding="utf-8")
        written.append(out_path)
        print(f"Wrote {out_path} ({len(parts)} files)\n")

    print(f"Done. {len(written)} markdown file(s) in: {OUT_DIR}")
    for p in written:
        print(f"  - {p.name}")


if __name__ == "__main__":
    main()
